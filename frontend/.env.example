# ============================================================
# Urban Nest — Frontend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ── API ──────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api

# ── Google OAuth 2.0 ─────────────────────────────────────────
VITE_SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# ── Cloudinary (if used client-side) ─────────────────────────
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
